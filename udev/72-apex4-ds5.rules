# SPDX-License-Identifier: CC0-1.0
# Access for the Apex 4 vendor interface and for a virtual DualSense's sub-devices.
#
#   sudo cp 72-apex4-ds5.rules /etc/udev/rules.d/ && sudo udevadm control --reload
#   sudo udevadm trigger
#
# Numbered below 73 on purpose: TAG+="uaccess" only sets a tag, and what acts on
# it is systemd's own 73-seat-late.rules. A 99- file sets the tag after the rule
# that would have read it, so it does nothing at all.

# The pad's vendor HID interface -- gyro, accelerometer, analogue triggers.
KERNEL=="hidraw*", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="2412", TAG+="uaccess"

# /dev/uhid, to create the virtual DualSense in the first place.
KERNEL=="uhid", TAG+="uaccess"

# The virtual controller's sub-devices. systemd tags the main gamepad node by
# itself, but leaves motion sensors, touchpad and headset jack as root:input --
# so gyro is unreadable and touchpad-click is silently dead. Matched by ids rather
# than by name, so it holds whatever the emulator calls the device; real Sony pads
# match too, which is harmless.
#
# **Both** product ids matter: 0ce6 is a DualSense and 0df2 a DualSense Edge, and
# this project presents the Edge by default (its four extra buttons are how the
# pad's back paddles become real buttons). A rule listing only 0ce6 silently stops
# applying the moment the emulation switches -- which is exactly what happened.
SUBSYSTEM=="input", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0ce6|0df2", TAG+="uaccess"
